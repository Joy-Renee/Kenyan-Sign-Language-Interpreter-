# Copy to .env (local) and set the same names in Vercel > Settings > Environment Variables.
# NEVER commit .env or paste a real key anywhere public.
MODEL_API_KEY=your-meta-model-api-key-here
META_MODEL=muse-spark-1.3
# Responses API reasoning effort; reasoning tokens count toward output tokens. Empty = omit the parameter.
META_REASONING_EFFORT=minimal
META_MAX_OUTPUT_TOKENS=300
META_TIMEOUT_MS=8000
RATE_LIMIT_PER_MIN=20
DAILY_MODEL_CALL_CAP=400
# Comma-separated origins allowed for cross-origin calls. Empty = same-origin only.
ALLOWED_ORIGINS=
LOG_SALT=change-me
