{
  "name": "ksl-assistant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Kenyan Sign Language assistant for a Deaf customer at a mobile money agent (hackathon prototype)",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --env-file=.env scripts/dev-server.mjs",
    "test": "node --test tests/fallback.test.mjs tests/proxy-lib.test.mjs tests/speech.test.js",
    "test:meta": "node --env-file=.env scripts/test-meta-call.mjs",
    "test:proxy": "node scripts/test-proxy.mjs",
    "test:parity": "node --test tests/parity.test.mjs",
    "train": "python training/train.py",
    "test:live": "node --test tests/live.test.js",
    "eval": "node --env-file=.env scripts/eval.mjs"
  },
  "dependencies": {
    "openai": "^7.47.0"
  }
}
